# ── Database (auto-filled by Vercel when you add Neon Postgres storage — see README) ──
# Vercel's Neon integration sets one of these automatically — you should not need
# to fill this in by hand. Listed here just so you know what the app looks for.
DATABASE_URL=

# ── Cron protection (generate any random string, e.g. `openssl rand -hex 32`) ──
CRON_SECRET=

# ── Optional: only needed if you want to override the built-in public RPC list ──
# Public RPCs (no key needed) are used by default: https://eth.llamarpc.com, https://cloudflare-eth.com
ETH_RPC_URL=
